# ── App Configuration ────────────────────────────────────────────────────────
APP_NAME="Mon5majeur API"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development # Options: development, staging, production

# ── Security & JWT Auth ───────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MongoDB Configuration ─────────────────────────────────────────────────────
# Connection string (use mongodb://localhost:27017 for local Docker container)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=mon5majeur_db

# ── CORS Settings ─────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1

# ── AWS S3 File Storage ───────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-north-1
AWS_S3_SIGNATURE_VERSION=s3v4

# ── Social OAuth (Google & Apple) ──────────────────────────────────────────────
SOCIAL_AUTH_GOOGLE_CLIENT_ID=
SOCIAL_AUTH_GOOGLE_SECRET=

APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_CERTIFICATE_KEY=
APPLE_CLIENT_SECRET=

# ── External Sports API (Goalserve) ───────────────────────────────────────────
GOALSERVE_API_KEY=

# ── Firebase Cloud Messaging (FCM Notifications) ─────────────────────────────
FCM_CREDENTIALS_PATH= # Path to serviceAccountKey.json

# ── Scheduler ─────────────────────────────────────────────────────────────────
ENABLE_SCHEDULER=true

# ── Email Server (SMTP) ───────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@mon5majeur.com
EMAILS_FROM_NAME=Mon5majeur

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,pdf,docx

# ── Redis (Optional/Future Caching) ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
