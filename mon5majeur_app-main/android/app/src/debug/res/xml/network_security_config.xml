<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY (this file lives in src/debug: Android never merges it into
  a release build). Lets a debug app talk plain HTTP to the backend running on
  the developer's Mac: 10.0.2.2 is the Mac as seen from the Android emulator.
  Everything else keeps Android's default (no cleartext traffic). Never add
  cleartextTrafficPermitted to a <base-config>, and never copy this file or the
  attribute below into src/main or src/profile.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
